# Parsed by Cloudflare Workers and applied to static asset responses; not served itself.
#
# Vite gives everything under /assets/ a content hash, so those URLs can never go
# stale and are safe to cache forever. Every other path deliberately keeps
# Cloudflare's default `public, max-age=0, must-revalidate` — that default is what
# lets `sw.js` (unhashed, at the root) pick up a new deploy. A broader rule such as
# /*.js would match it and freeze the app on an old service worker.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
