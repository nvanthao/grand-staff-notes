{
  "name": "music-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A beginner's lookup for where a note sits on the treble or bass staff.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "vue-tsc --build",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.129.0"
  }
}
